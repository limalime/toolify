{
	"name": "toolify",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"prebuild": "node ./scripts/check-locales.mjs",
		"locales:check": "node ./scripts/check-locales.mjs",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest run",
		"e2e": "playwright test",
		"deploy": "node ./scripts/check-locales.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "node ./scripts/check-locales.mjs && opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "node ./scripts/check-locales.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@jsquash/avif": "^2.1.1",
		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/oxipng": "^2.3.0",
		"@jsquash/resize": "^2.1.1",
		"@jsquash/webp": "^1.5.0",
		"@opennextjs/cloudflare": "^1.20.3",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"comlink": "^4.4.2",
		"fflate": "^0.8.3",
		"jspdf": "^4.2.1",
		"libheif-js": "^1.23.5",
		"lucide-react": "^1.76.0",
		"motion": "^14.14.0",
		"next": "16.4.5",
		"next-intl": "^4.15.3",
		"next-themes": "^0.4.6",
		"pdfjs-dist": "^6.5.438",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"shadcn": "^4.23.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@eslint/eslintrc": "^3",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/postcss": "^4",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"eslint": "^9",
		"eslint-config-next": "16.4.5",
		"jsdom": "^31.0.1",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.1.1",
		"wrangler": "^4.165.0"
	}
}
