{
	"name": "toolify",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"prebuild": "node ./scripts/check-locales.mjs",
		"locales:check": "node ./scripts/check-locales.mjs",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest run",
		"e2e": "playwright test",
		"deploy": "node ./scripts/check-locales.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "node ./scripts/check-locales.mjs && opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "node ./scripts/check-locales.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@codemirror/lang-cpp": "6.0.3",
