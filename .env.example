# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Google Analytics 4 measurement ID, used with Consent Mode v2
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google Search Console verification token, the content value of the
# meta tag. Leave empty to skip the tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form delivery endpoint (form service URL). Without it the
# contact form answers honestly that delivery is unavailable.
CONTACT_FORM_ACTION=
